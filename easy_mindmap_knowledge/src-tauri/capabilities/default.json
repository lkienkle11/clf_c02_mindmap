{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: SQL for the local database, and opening only YouTube search results and AWS documentation pages in the system browser",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://www.youtube.com/results*"
        },
        {
          "url": "https://docs.aws.amazon.com/*"
        },
        {
          "url": "https://aws.amazon.com/*"
        }
      ]
    }
  ]
}
